# ==============================================================================
# 🎬 fnOS STRM Autopilot - 环境变量配置模板
# 复制本文件为 .env 并填入你自己的配置：cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 豆瓣想看动态同步配置 (零 Key 极简流)
# ------------------------------------------------------------------------------
# 你的豆瓣个人主页后缀 ID（在浏览器打开豆瓣个人主页，URL 最后一段字符串即是）
# 例如: https://www.douban.com/people/your_douban_id/ 则填 your_douban_id
DOUBAN_UID="your_douban_id"

# ------------------------------------------------------------------------------
# 2. TMDb (The Movie Database) 元数据配置 (免费申请)
# ------------------------------------------------------------------------------
# 申请地址: https://www.themoviedb.org/settings/api (注册账号后在设置中申请开发者 API)
TMDB_API_KEY="your_tmdb_api_key_here"
TMDB_READ_TOKEN="your_tmdb_v4_read_access_token_here"

# ------------------------------------------------------------------------------
# 3. Watchmode 全球流媒体版权库 (每月 2500 次免费配额)
# ------------------------------------------------------------------------------
# 申请地址: https://api.watchmode.com/ (注册即送免费 API Key)
# 用于锁定全球流媒体（Netflix/Disney+/Apple TV+/Max/Prime Video）首播上线排期
WATCHMODE_API_KEY="your_watchmode_api_key_here"

# ------------------------------------------------------------------------------
# 4. Bangumi (番组计划) 开放平台配置 (二次元新番追更)
# ------------------------------------------------------------------------------
# 开放接口主页: https://github.com/bangumi/api
# 留空或填写自定义客户端标识 (例如: fnos-autopilot/1.0)
BANGUMI_APP_ID="fnos-autopilot/1.0"

# ------------------------------------------------------------------------------
# 5. 飞牛私有云 (fnOS) 与 SmartStrm 服务端配置
# ------------------------------------------------------------------------------
# 飞牛 NAS 本地局域网 IP
FNOS_HOST="192.168.1.100"

# SmartStrm API 监听端口 (飞牛应用中心默认 8024)
SMARTSTRM_PORT="8024"

# SmartStrm 基础端点地址
SMARTSTRM_BASE_URL="http://192.168.1.100:8024"

# 飞牛影视 SQLite 数据库路径 (fnOS 宿主机默认路径)
TRIMMEDIA_DB_PATH="/usr/local/apps/@appdata/trim.media/database/trimmedia.db"

# ------------------------------------------------------------------------------
# 6. 通知推送矩阵 (可选)
# ------------------------------------------------------------------------------
# 飞书群自定义机器人 Webhook (留空则仅在终端回显日志)
# 申请方式: 飞书群 -> 设置 -> 自定义机器人 -> 添加机器人 -> 复制 Webhook 地址
FEISHU_WEBHOOK_URL=""

# 企业微信机器人 Webhook (可选)
WECOM_WEBHOOK_URL=""

# Telegram 机器人通知 (可选)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ------------------------------------------------------------------------------
# 7. 高级自治与缓存调优参数
# ------------------------------------------------------------------------------
# SQLite 强缓存过期时间（天）- 防频次超限与保护免费 API 配额
CACHE_EXPIRE_DAYS=14

# SubHD 字幕成熟度嗅探超时时间（秒）
SUBHD_TIMEOUT=15

# IMDb 高分新片准入门槛 (默认 7.0 分)
IMDB_MIN_SCORE=7.0

# 字幕成熟缓冲默认等待周期（天）
SUBTITLE_BUFFER_DAYS=7
